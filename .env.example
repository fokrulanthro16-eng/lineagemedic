# LineageMedic configuration.
# Copy to `.env` and edit. `.env` is gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# Integration mode
# ---------------------------------------------------------------------------
# fixture  = Demo Fixture Mode. No DataHub required. All DataHub/MCP context is
#            served from committed fixtures and is labelled as such in the UI
#            and in every API response. This is the default.
# live     = Requires a reachable DataHub instance and MCP server. If either is
#            unreachable the API reports the failure; it never silently falls
#            back to fixtures.
LINEAGEMEDIC_MODE=fixture

# ---------------------------------------------------------------------------
# DataHub (only used when LINEAGEMEDIC_MODE=live)
# ---------------------------------------------------------------------------
# GMS endpoint of a local DataHub OSS Quickstart instance.
DATAHUB_GMS_URL=http://localhost:8080
# Personal access token minted in the DataHub UI (Settings -> Access Tokens).
# Leave blank when DataHub runs with metadata service auth disabled (the
# Quickstart default). NEVER commit a real token.
DATAHUB_GMS_TOKEN=
# DataHub frontend, used only to build human-clickable links in the UI.
DATAHUB_FRONTEND_URL=http://localhost:9002

# ---------------------------------------------------------------------------
# DataHub MCP server (only used when LINEAGEMEDIC_MODE=live)
# ---------------------------------------------------------------------------
MCP_SERVER_URL=http://localhost:8000/mcp
MCP_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Optional local LLM (Ollama). Entirely optional — the deterministic engine is
# the reliable path and produces every diagnosis on its own.
# ---------------------------------------------------------------------------
# deterministic = evidence-only narration, no model required (default)
# ollama        = additionally ask a local Ollama model to narrate the evidence
LINEAGEMEDIC_LLM_PROVIDER=deterministic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
LINEAGEMEDIC_API_HOST=127.0.0.1
LINEAGEMEDIC_API_PORT=8000
LINEAGEMEDIC_LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API from a browser.
LINEAGEMEDIC_CORS_ORIGINS=http://localhost:5173
