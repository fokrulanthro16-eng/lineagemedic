# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
# Isolated Python 3.11 environment for the DataHub CLI. Kept separate from
# .venv so the DataHub SDK's pinned dependency tree cannot constrain the
# application's own.
.venv-datahub/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# Node
node_modules/
dist/
.vite/
coverage/
playwright-report/
test-results/

# Environment / secrets — never commit real credentials
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# DataHub CLI local state
.datahubenv

# Local runtime data
*.db
*.sqlite
*.sqlite3
!packages/lineagemedic/data/*.sql
logs/
*.log

# OS / editor
Thumbs.db
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
