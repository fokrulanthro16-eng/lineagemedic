{
  "openapi": "3.1.0",
  "info": {
    "title": "LineageMedic API",
    "description": "Diagnose, contain, and heal silent data failures before they break production ML. Uses DataHub for schema, ownership, and lineage context.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "status"
        ],
        "summary": "Health",
        "description": "Liveness probe. Does not touch DataHub.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/status/datahub": {
      "get": {
        "tags": [
          "status"
        ],
        "summary": "Datahub Status",
        "description": "Report DataHub connectivity truthfully, including when it is absent.",
        "operationId": "datahub_status_status_datahub_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataHubStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/status/mcp": {
      "get": {
        "tags": [
          "status"
        ],
        "summary": "Mcp Status",
        "description": "List MCP tools available, and the calls the last diagnosis made.",
        "operationId": "mcp_status_status_mcp_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/McpCapabilityResponse"
                }
              }
            }
          }
        }
      }
    },
    "/status/integrations": {
      "get": {
        "tags": [
          "status"
        ],
        "summary": "Integration Status",
        "description": "Consolidated status for the UI status bar.",
        "operationId": "integration_status_status_integrations_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntegrationStatus"
                }
              }
            }
          }
        }
      }
    },
    "/scenarios": {
      "get": {
        "tags": [
          "incidents"
        ],
        "summary": "List Scenarios",
        "description": "The runnable scenarios, ordered worst-expected-case first.",
        "operationId": "list_scenarios_scenarios_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ScenarioSummary"
                  },
                  "type": "array",
                  "title": "Response List Scenarios Scenarios Get"
                }
              }
            }
          }
        }
      }
    },
    "/diagnose": {
      "post": {
        "tags": [
          "incidents"
        ],
        "summary": "Diagnose",
        "description": "Run the seven-agent workflow. Performs no mutation.",
        "operationId": "diagnose_diagnose_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiagnoseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Diagnosis"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/incidents": {
      "get": {
        "tags": [
          "incidents"
        ],
        "summary": "List Incidents",
        "description": "All diagnoses computed since the last reset, newest first.",
        "operationId": "list_incidents_incidents_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Diagnosis"
                  },
                  "type": "array",
                  "title": "Response List Incidents Incidents Get"
                }
              }
            }
          }
        }
      }
    },
    "/incidents/{incident_id}": {
      "get": {
        "tags": [
          "incidents"
        ],
        "summary": "Get Incident",
        "operationId": "get_incident_incidents__incident_id__get",
        "parameters": [
          {
            "name": "incident_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Incident Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Diagnosis"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/incidents/{incident_id}/evidence": {
      "get": {
        "tags": [
          "incidents"
        ],
        "summary": "Get Evidence",
        "description": "Evidence and the MCP call trace backing one incident.",
        "operationId": "get_evidence_incidents__incident_id__evidence_get",
        "parameters": [
          {
            "name": "incident_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Incident Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Evidence Incidents  Incident Id  Evidence Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/audit": {
      "get": {
        "tags": [
          "incidents"
        ],
        "summary": "Get Audit",
        "description": "Append-only audit log, newest first.",
        "operationId": "get_audit_audit_get",
        "parameters": [
          {
            "name": "incident_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Incident Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuditEvent"
                  },
                  "title": "Response Get Audit Audit Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/incidents/{incident_id}/approve": {
      "post": {
        "tags": [
          "approval"
        ],
        "summary": "Approve",
        "description": "Record a human decision on the remediation plan.",
        "operationId": "approve_incidents__incident_id__approve_post",
        "parameters": [
          {
            "name": "incident_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Incident Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/incidents/{incident_id}/writeback": {
      "post": {
        "tags": [
          "approval"
        ],
        "summary": "Writeback",
        "description": "Write incident knowledge to DataHub. Requires prior approval.",
        "operationId": "writeback_incidents__incident_id__writeback_post",
        "parameters": [
          {
            "name": "incident_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Incident Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WritebackReceipt"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/demo/reset": {
      "post": {
        "tags": [
          "demo"
        ],
        "summary": "Demo Reset",
        "description": "Clear LineageMedic-owned state only.\n\nDoes not touch DataHub, and does not rebuild the warehouse. Use\n``scripts/setup.ps1`` to regenerate the SQLite database.",
        "operationId": "demo_reset_demo_reset_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetResponse"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "status"
        ],
        "summary": "Root",
        "description": "Service banner with the effective, redacted configuration.",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Root  Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActionRisk": {
        "type": "string",
        "enum": [
          "safe",
          "reversible",
          "destructive"
        ],
        "title": "ActionRisk",
        "description": "How dangerous a proposed remediation action is."
      },
      "AgentName": {
        "type": "string",
        "enum": [
          "quality",
          "context",
          "impact",
          "root_cause",
          "remediation",
          "safety",
          "writeback"
        ],
        "title": "AgentName",
        "description": "The seven workflow agents, in execution order."
      },
      "AgentStep": {
        "properties": {
          "agent": {
            "$ref": "#/components/schemas/AgentName"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "duration_ms": {
            "type": "number",
            "title": "Duration Ms"
          },
          "ok": {
            "type": "boolean",
            "title": "Ok",
            "default": true
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceItem"
            },
            "type": "array",
            "title": "Evidence"
          },
          "mcp_calls": {
            "items": {
              "$ref": "#/components/schemas/McpCallRecord"
            },
            "type": "array",
            "title": "Mcp Calls"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "agent",
          "title",
          "summary",
          "started_at",
          "duration_ms"
        ],
        "title": "AgentStep",
        "description": "One agent's execution record, for the UI timeline."
      },
      "ApprovalRequest": {
        "properties": {
          "approved": {
            "type": "boolean",
            "title": "Approved",
            "description": "True to approve the plan, False to reject it."
          },
          "approver": {
            "type": "string",
            "maxLength": 120,
            "title": "Approver",
            "description": "Who made the decision. Recorded in the audit log.",
            "default": "operator"
          },
          "note": {
            "type": "string",
            "maxLength": 2000,
            "title": "Note",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "approved"
        ],
        "title": "ApprovalRequest"
      },
      "ApprovalResponse": {
        "properties": {
          "incident_id": {
            "type": "string",
            "title": "Incident Id"
          },
          "approval_state": {
            "$ref": "#/components/schemas/ApprovalState"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "incident_id",
          "approval_state",
          "message"
        ],
        "title": "ApprovalResponse"
      },
      "ApprovalState": {
        "type": "string",
        "enum": [
          "pending",
          "approved",
          "rejected",
          "not_required"
        ],
        "title": "ApprovalState",
        "description": "Human approval gate state for a remediation plan."
      },
      "Asset": {
        "properties": {
          "urn": {
            "type": "string",
            "title": "Urn"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "$ref": "#/components/schemas/AssetKind"
          },
          "platform": {
            "type": "string",
            "title": "Platform"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags"
          },
          "owners": {
            "items": {
              "$ref": "#/components/schemas/Owner"
            },
            "type": "array",
            "title": "Owners"
          },
          "schema_fields": {
            "items": {
              "$ref": "#/components/schemas/SchemaField"
            },
            "type": "array",
            "title": "Schema Fields"
          },
          "upstreams": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Upstreams"
          },
          "downstreams": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Downstreams"
          },
          "source": {
            "$ref": "#/components/schemas/DataSource"
          },
          "datahub_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Datahub Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "urn",
          "name",
          "kind",
          "platform",
          "source"
        ],
        "title": "Asset",
        "description": "A node in the lineage graph: dataset, feature table, model, or endpoint."
      },
      "AssetKind": {
        "type": "string",
        "enum": [
          "dataset",
          "feature_table",
          "ml_model",
          "endpoint"
        ],
        "title": "AssetKind",
        "description": "The kind of node in the lineage graph."
      },
      "AuditEvent": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "incident_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Incident Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "diagnosis_started",
              "diagnosis_completed",
              "approval_requested",
              "approval_granted",
              "approval_rejected",
              "writeback_attempted",
              "writeback_applied",
              "writeback_blocked",
              "demo_reset"
            ],
            "title": "Kind"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "actor": {
            "type": "string",
            "title": "Actor",
            "default": "system"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "incident_id",
          "kind",
          "message"
        ],
        "title": "AuditEvent",
        "description": "An append-only record of something the application did."
      },
      "CheckStatus": {
        "type": "string",
        "enum": [
          "pass",
          "fail"
        ],
        "title": "CheckStatus",
        "description": "Outcome of a single data-quality check."
      },
      "DataHubStatusResponse": {
        "properties": {
          "connected": {
            "type": "boolean",
            "title": "Connected"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "gms_url": {
            "type": "string",
            "title": "Gms Url"
          },
          "frontend_url": {
            "type": "string",
            "title": "Frontend Url"
          },
          "token_configured": {
            "type": "boolean",
            "title": "Token Configured"
          },
          "fixture_mode_notice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fixture Mode Notice"
          }
        },
        "type": "object",
        "required": [
          "connected",
          "detail",
          "gms_url",
          "frontend_url",
          "token_configured",
          "fixture_mode_notice"
        ],
        "title": "DataHubStatusResponse"
      },
      "DataSource": {
        "type": "string",
        "enum": [
          "live_datahub",
          "fixture"
        ],
        "title": "DataSource",
        "description": "Where a piece of context actually came from.\n\nThis is the anti-fabrication primitive. ``FIXTURE`` is surfaced in the API\nand rendered as a banner in the UI so a demo can never be mistaken for a\nlive DataHub reading."
      },
      "DiagnoseRequest": {
        "properties": {
          "scenario_id": {
            "type": "string",
            "title": "Scenario Id",
            "description": "Scenario to run. See GET /scenarios."
          }
        },
        "type": "object",
        "required": [
          "scenario_id"
        ],
        "title": "DiagnoseRequest"
      },
      "Diagnosis": {
        "properties": {
          "incident_id": {
            "type": "string",
            "title": "Incident Id"
          },
          "scenario_id": {
            "type": "string",
            "title": "Scenario Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "confidence_explanation": {
            "type": "string",
            "title": "Confidence Explanation"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "quality_checks": {
            "items": {
              "$ref": "#/components/schemas/QualityCheck"
            },
            "type": "array",
            "title": "Quality Checks"
          },
          "lineage": {
            "$ref": "#/components/schemas/LineageGraph"
          },
          "impact": {
            "$ref": "#/components/schemas/ImpactAssessment"
          },
          "root_causes": {
            "items": {
              "$ref": "#/components/schemas/RootCauseHypothesis"
            },
            "type": "array",
            "title": "Root Causes"
          },
          "remediation": {
            "items": {
              "$ref": "#/components/schemas/RemediationAction"
            },
            "type": "array",
            "title": "Remediation"
          },
          "safety": {
            "$ref": "#/components/schemas/SafetyVerdict"
          },
          "approval_state": {
            "$ref": "#/components/schemas/ApprovalState"
          },
          "writeback": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WritebackReceipt"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceItem"
            },
            "type": "array",
            "title": "Evidence"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/AgentStep"
            },
            "type": "array",
            "title": "Steps"
          },
          "mcp_calls": {
            "items": {
              "$ref": "#/components/schemas/McpCallRecord"
            },
            "type": "array",
            "title": "Mcp Calls"
          },
          "context_source": {
            "$ref": "#/components/schemas/DataSource"
          },
          "fixture_mode_notice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fixture Mode Notice"
          },
          "narration": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Narration"
          },
          "narration_provider": {
            "type": "string",
            "title": "Narration Provider",
            "default": "deterministic"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "incident_id",
          "scenario_id",
          "title",
          "severity",
          "confidence",
          "confidence_explanation",
          "summary",
          "lineage",
          "impact",
          "safety",
          "approval_state",
          "context_source"
        ],
        "title": "Diagnosis",
        "description": "The complete structured output of one workflow run.\n\nThis is the object the API returns and the UI renders. It is fully\nself-describing: severity, evidence, impact, remediation, approval state,\nand the provenance of every DataHub fact it relied on."
      },
      "EvidenceItem": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "agent": {
            "$ref": "#/components/schemas/AgentName"
          },
          "source": {
            "$ref": "#/components/schemas/DataSource"
          },
          "references": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "References"
